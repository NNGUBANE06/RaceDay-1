@model ProfileViewModel
@{ViewData["Title"]="My profile";}<h1>My profile</h1><div class="card card-body"><p><strong>Name:</strong> @Model.FirstName @Model.LastName</p><p><strong>Email:</strong> @Model.Email</p><p><strong>Role:</strong> @Model.Role</p><a asp-action="Edit" class="btn btn-primary align-self-start">Edit profile</a></div>
