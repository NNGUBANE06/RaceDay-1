@model ProfileViewModel
@{ViewData["Title"]="My profile";}<h1>My profile</h1><div class="card card-body">@if(!string.IsNullOrWhiteSpace(Model.ProfileImageUrl)){<img src="@Model.ProfileImageUrl" alt="Profile picture" class="rounded-circle mb-3" style="width:140px;height:140px;object-fit:cover"/>}<p><strong>Name:</strong> @Model.FirstName @Model.LastName</p><p><strong>Email:</strong> @Model.Email</p><p><strong>Role:</strong> @Model.Role</p><a asp-action="Edit" class="btn btn-primary align-self-start">Edit profile</a></div>
