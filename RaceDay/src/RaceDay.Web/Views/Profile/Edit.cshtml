@model ProfileFormModel
@{ViewData["Title"]="Edit profile";}<h1>Edit profile</h1><form method="post" enctype="multipart/form-data" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"/></div><div class="mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"/></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">New password (optional)</label><input asp-for="NewPassword" type="password" class="form-control"/><small class="text-muted">Leave blank to keep your current password.</small></div><div class="mb-3"><label asp-for="ProfileImage" class="form-label">Profile picture (JPEG, PNG or WebP; max 5 MB)</label><input asp-for="ProfileImage" type="file" accept="image/jpeg,image/png,image/webp" class="form-control"/></div><button class="btn btn-primary">Save changes</button></form>
