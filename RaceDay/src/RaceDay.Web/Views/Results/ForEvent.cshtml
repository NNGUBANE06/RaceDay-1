@model List<ResultViewModel>
@{ViewData["Title"]="Event results";var enrolments=ViewBag.Enrolments as List<EnrolmentViewModel>??new();}
<h1>Results · @ViewBag.Event?.Name</h1><form asp-action="Capture" method="post" class="card card-body mb-4"><input type="hidden" name="eventId" value="@ViewBag.EventId"/><h2 class="h5">Record a finish</h2><div class="row g-2"><div class="col-md-5"><select name="EnrolmentId" class="form-select" required>@foreach(var e in enrolments){<option value="@e.Id">@e.ParticipantName — @e.CategoryName</option>}</select></div><div class="col-md-3"><input name="FinishTime" class="form-control" placeholder="hh:mm:ss" required/></div><div class="col-md-2"><input name="Position" type="number" min="1" class="form-control" placeholder="Position" required/></div><div class="col-md-2"><button class="btn btn-primary w-100">Save result</button></div></div></form>
<h2 class="h4">Published results</h2><table class="table table-striped"><thead><tr><th>Position</th><th>Participant</th><th>Finish time</th></tr></thead><tbody>@foreach(var r in Model.OrderBy(x=>x.Position)){<tr><td>@r.Position</td><td>@r.ParticipantName</td><td>@r.FinishTime</td></tr>}</tbody></table>
