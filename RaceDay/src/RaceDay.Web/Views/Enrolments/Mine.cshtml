@model List<EnrolmentViewModel>
@{ViewData["Title"]="My enrolments";}<h1>My enrolments</h1>@if(Model.Count==0){<p class="text-muted">You have not enrolled in an event yet.</p>}<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Event</th><th>Category</th><th>Enrolled</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.EnrolledAt.ToString("dd MMM yyyy")</td><td><span class="badge bg-success">Enrolled</span></td></tr>}</tbody></table></div>
