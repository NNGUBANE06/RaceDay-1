@{ ViewData["Title"] = "Dashboard"; var events = ViewBag.Events as List<EventViewModel> ?? new(); }
<h1 class="mb-1">Hello, @ViewBag.UserName!</h1><p class="text-muted">Your RaceDay dashboard · @ViewBag.Role</p>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-muted">Events available</div><div class="display-6 fw-bold">@events.Count</div></div></div></div><div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-muted">Your role</div><div class="h3 mt-2">@ViewBag.Role</div></div></div></div><div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-muted">Next step</div><div class="h5 mt-2">Explore an event</div></div></div></div></div>
<h2 class="h4">Events</h2>@if (events.Count == 0) { <div class="alert alert-info">No events are available yet, or the API could not be reached. Start the RaceDay API and refresh this page.</div> } else { <div class="row g-3">@foreach (var e in events) { <div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><span class="badge bg-primary">@e.EventType</span><h3 class="h5 mt-2">@e.Name</h3><p class="text-muted">@e.Location</p><p>@e.Description</p><div>@e.DistanceKm km · @e.Date.ToString("dd MMM yyyy")</div></div></div></div> }</div> }
