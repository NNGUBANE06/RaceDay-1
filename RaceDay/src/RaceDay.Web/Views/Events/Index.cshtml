@model List<EventViewModel>
@{ViewData["Title"]="Events";}<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Race events</h1><p class="text-muted">Find your next starting line.</p></div>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-primary" asp-action="Create">+ Create event</a>}</div>
@if(Model.Count==0){<div class="alert alert-info">No events found.</div>}<div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body"><span class="badge bg-info text-dark">@e.EventType</span><h2 class="h5 mt-2">@e.Name</h2><p class="text-muted">@e.Location · @e.Date.ToString("dd MMM yyyy")</p><p>@e.Description</p><p class="fw-semibold">@e.DistanceKm km</p><a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-primary">Details</a>@if(Context.Session.GetString("Role")=="Organiser"){<a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary ms-1">Edit</a><a asp-controller="Enrolments" asp-action="ForEvent" asp-route-eventId="@e.Id" class="btn btn-sm btn-outline-secondary ms-1">Enrolments</a><a asp-controller="Results" asp-action="ForEvent" asp-route-eventId="@e.Id" class="btn btn-sm btn-outline-secondary ms-1">Results</a><form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-danger mt-2">Delete</button></form>}</div></div></div>}</div>
