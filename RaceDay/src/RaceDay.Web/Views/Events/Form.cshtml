@model EventFormModel
@{ViewData["Title"]=Model.Id==0?"Create event":"Edit event";}<h1>@ViewData["Title"]</h1><form method="post" class="card card-body shadow-sm"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="datetime-local" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><button class="btn btn-primary">Save event</button></form>
