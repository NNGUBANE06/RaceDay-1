@model EventViewModel
@{ViewData["Title"]=Model.Name;var cats=ViewBag.Categories as List<CategoryViewModel>??new();}
<h1>@Model.Name</h1><p class="text-muted">@Model.Date.ToString("f") · @Model.Location · @Model.DistanceKm km · @Model.EventType</p><p>@Model.Description</p><h2 class="h4 mt-4">Categories</h2>@if(cats.Count==0){<p>No categories added yet.</p>}else{<ul class="list-group mb-3">@foreach(var c in cats){<li class="list-group-item d-flex justify-content-between">@c.Name @if(Context.Session.GetString("Role")=="Organiser"){<form asp-controller="Categories" asp-action="Delete" method="post"><input type="hidden" name="eventId" value="@Model.Id"/><input type="hidden" name="id" value="@c.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form>}</li>}</ul>}
@if(Context.Session.GetString("Role")=="Organiser"){<form asp-controller="Categories" asp-action="Create" method="post" class="card card-body mb-3"><input type="hidden" name="eventId" value="@Model.Id"/><label class="form-label">Add age or distance category</label><div class="input-group"><input name="Name" class="form-control" placeholder="e.g. 10 km / Under 20" required/><button class="btn btn-primary">Add category</button></div></form>}
@if(Context.Session.GetString("Role")=="Participant" && cats.Count>0){<form asp-controller="Enrolments" asp-action="Enrol" method="post" class="card card-body"><input type="hidden" name="eventId" value="@Model.Id"/><label class="form-label">Choose a category to enrol</label><select name="CategoryId" class="form-select mb-2">@foreach(var c in cats){<option value="@c.Id">@c.Name</option>}</select><button class="btn btn-primary">Enrol now</button></form>}
