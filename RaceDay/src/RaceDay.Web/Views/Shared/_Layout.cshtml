<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /><link rel="stylesheet" href="~/css/site.css" /></head>
<body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RaceDay</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#raceNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="raceNav"><div class="navbar-nav ms-auto">
@if(Context.Session.GetString("ApiCookie") is not null){
<a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Enrolments" asp-action="Mine">My enrolments</a><a class="nav-link" asp-controller="Results" asp-action="Mine">My results</a>}
<a class="nav-link" asp-controller="Profile" asp-action="Index">My profile</a>
<form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-outline-light btn-sm ms-lg-2 mt-2 mt-lg-0">Log out</button></form>
}else{<a class="nav-link" asp-controller="Home" asp-action="Index">Home</a><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>}
</div></div></div></nav><main class="container py-4">@if (TempData["Message"] is not null) { <div class="alert alert-info alert-dismissible fade show">@TempData["Message"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }@RenderBody()</main><footer class="text-center text-muted py-4">RaceDay · Manage races. Celebrate every finish.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>